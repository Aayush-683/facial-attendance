# Auto-added by Vercel when you connect Neon + Blob in the Storage tab.
# Pull them locally with: vercel env pull .env.local
DATABASE_URL=postgres://...
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Add these yourself in Vercel > Settings > Environment Variables
AUTH_SECRET=long-random-string-for-signing-logins
ADMIN_PASSWORD=change-me
KIOSK_PIN=1234
CRON_SECRET=another-long-random-string

# Free tier limits shown in the admin Storage tab (MB)
DB_LIMIT_MB=512
BLOB_LIMIT_MB=1024
